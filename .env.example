# URL deployment Apps Script Web App (opsional; proxy punya nilai bawaan).
GAS_WEB_APP_URL=

# Kunci API Indonesia untuk lapisan rumah sakit dan halte Transjakarta di
# Peta Global. Tanpa kunci, kedua lapisan itu menampilkan pesan "belum diatur".
# Dapatkan di https://dashboard.apiindonesia.id
API_INDONESIA_KEY=

# Semua variabel di bawah bersifat OPSIONAL. Globe tetap berjalan tanpa kunci
# apa pun; lapisan yang memerlukannya hanya menampilkan pesan yang jelas.
#
# TOMTOM_API_KEY   — lapisan kemacetan (ubin vektor lalu lintas TomTom).
# FIRMS_MAP_KEY    — titik api aktif NASA FIRMS (kunci gratis setelah daftar).
# OPENAI_API_KEY   — ringkasan teks pada panel HUD.
# OPENSKY_CLIENT_ID / OPENSKY_CLIENT_SECRET atau OPENSKY_USERNAME /
# OPENSKY_PASSWORD — hanya untuk memperbesar kuota harian OpenSky; tanpa
# kunci, lapisan penerbangan tetap memakai kuota anonim.
TOMTOM_API_KEY=
FIRMS_MAP_KEY=
OPENAI_API_KEY=
