{
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/pii.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/celestrak/:group",
      "destination": "/api/celestrak?group=:group"
    },
    {
      "source": "/models/:file",
      "destination": "/peta/models/:file"
    },
    {
      "source": "/mic.svg",
      "destination": "/peta/mic.svg"
    },
    {
      "source": "/peta",
      "destination": "/peta/index.html"
    },
    {
      "source": "/peta/",
      "destination": "/peta/index.html"
    },
    {
      "source": "/ibadah",
      "destination": "/ibadah.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/daftar",
      "destination": "/daftar.html"
    },
    {
      "source": "/lembaga",
      "destination": "/lembaga.html"
    },
    {
      "source": "/formulir",
      "destination": "/formulir.html"
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
