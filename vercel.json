      "maxDuration": 15
    },
    "api/adsblol/trace.js": {
      "maxDuration": 15
    },
    "api/cctv/frame/[id].js": {
      "maxDuration": 15
    },
    "api/cctv/health.js": {
      "maxDuration": 30
    },
    "api/cctv/media/[id].js": {
      "maxDuration": 30
    },
    "api/cctv/sources.js": {
      "maxDuration": 30
    },
    "api/celestrak.js": {
      "maxDuration": 20
    },
    "api/celestrak/[group].js": {
      "maxDuration": 20
    },
    "api/firms.js": {
      "maxDuration": 30
    },
    "api/gbfs/[slug].js": {
      "maxDuration": 15
    },
    "api/geocode/json.js": {
