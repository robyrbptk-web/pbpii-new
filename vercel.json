    "api/launches.js": {
      "maxDuration": 25
    },
    "api/military-installations.js": {
      "maxDuration": 30
    },
    "api/muslim/jadwal.js": {
      "maxDuration": 20
    },
    "api/muslim/kalender.js": {
      "maxDuration": 20
    },
    "api/muslim/kota.js": {
      "maxDuration": 20
    },
    "api/muslim/qibla.js": {
      "maxDuration": 20
    },
    "api/muslim/quran.js": {
      "maxDuration": 20
    },
    "api/openai/hud-summary.js": {
      "maxDuration": 15
    },
    "api/opensky-track.js": {
      "maxDuration": 15
    },
    "api/opensky.js": {
      "maxDuration": 25
    },
    "api/overpass.js": {
      "maxDuration": 25
    },
    "api/pii.js": {
      "maxDuration": 30
    },
    "api/radio/click/[id].js": {
      "maxDuration": 10
    },
    "api/radio/stations.js": {
      "maxDuration": 30
    },
    "api/regional-brief.js": {
      "maxDuration": 30
    },
    "api/route.js": {
      "maxDuration": 15
    },
    "api/sekolah.js": {
      "maxDuration": 30
    },
    "api/setup/keys.js": {
      "maxDuration": 15
    },
    "api/setup/status.js": {
      "maxDuration": 15
    },
    "api/terrain/heights.js": {
      "maxDuration": 14
    },
    "api/tomtom/flow/[z]/[x]/[y].js": {
      "maxDuration": 15
    },
    "api/tomtom/status.js": {
      "maxDuration": 15
    },
    "api/volcanoes.js": {
      "maxDuration": 15
    },
    "api/weather-effects.js": {
      "maxDuration": 15
    },
    "api/wilayah.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/celestrak/:group",
      "destination": "/api/celestrak?group=:group"
    },
    {
      "source": "/models/:file",
      "destination": "/peta/models/:file"
    },
    {
      "source": "/mic.svg",
      "destination": "/peta/mic.svg"
    },
    {
      "source": "/peta",
      "destination": "/peta/index.html"
    },
    {
      "source": "/peta/",
      "destination": "/peta/index.html"
    },
    {
      "source": "/ibadah",
      "destination": "/ibadah.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/daftar",
      "destination": "/daftar.html"
    },
    {
      "source": "/lembaga",
      "destination": "/lembaga.html"
    },
    {
      "source": "/formulir",
      "destination": "/formulir.html"
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
