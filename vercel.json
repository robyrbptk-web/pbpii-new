{
  "functions": {
    "api/pii.js": {
      "maxDuration": 10
    },
    "api/sekolah.js": {
      "maxDuration": 30
    },
    "api/volcanoes.js": {
      "maxDuration": 15
    },
    "api/indonesia/hospitals.js": {
      "maxDuration": 30
    },
    "api/indonesia/transjakarta.js": {
      "maxDuration": 30
    },
    "api/celestrak.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/celestrak/:group",
      "destination": "/api/celestrak?group=:group"
    },
    {
      "source": "/models/:file",
      "destination": "/peta/models/:file"
    },
    {
      "source": "/mic.svg",
      "destination": "/peta/mic.svg"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
